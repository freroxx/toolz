<?xml version="1.0" encoding="utf-8"?>
<!-- Static picker preview for Pomodoro widget (API 31+). Mirrors compact tier.
     Preview-safe: only @color/@drawable (never ?attr). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="12dp"
    android:background="@drawable/widget_background">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FOCUS • READY"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="@color/widget_preview_on_container"
        android:background="@drawable/widget_button_tonal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="24:59"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="@color/widget_preview_text"
        android:layout_marginTop="6dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SESSION 3 OF 8"
        android:textSize="10sp"
        android:textColor="@color/widget_preview_subtext"
        android:layout_marginTop="2dp" />

    <ProgressBar
        android:layout_width="120dp"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        style="?android:attr/progressBarStyleHorizontal"
        android:progress="35"
        android:max="100"
        android:progressTint="@color/widget_preview_accent"
        android:progressBackgroundTint="@color/widget_preview_track" />

    <FrameLayout
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/widget_preview_play_bg">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_widget_play"
            android:tint="@color/widget_preview_on_accent"
            android:contentDescription="@null" />
    </FrameLayout>
</LinearLayout>
