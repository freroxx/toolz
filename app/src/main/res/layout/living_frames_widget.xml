<?xml version="1.0" encoding="utf-8"?>
<!-- Living Widgets: two ImageViews (crop + fit), only one visible at a time.
     FIT is handled by view switching — zero extra Binder bytes.
     Preview-safe: only @color/@drawable. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/living_frame_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="6dp">

    <ImageView
        android:id="@+id/living_frame_image_crop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_music_note"
        android:contentDescription="@string/widget_living_frames_label" />

    <ImageView
        android:id="@+id/living_frame_image_fit"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:visibility="gone"
        android:contentDescription="@string/widget_living_frames_label" />

    <TextView
        android:id="@+id/living_frame_caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="10dp"
        android:background="#99000000"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:maxLines="1"
        android:visibility="gone" />
</FrameLayout>
