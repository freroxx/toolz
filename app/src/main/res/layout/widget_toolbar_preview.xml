<?xml version="1.0" encoding="utf-8"?>
<!-- Static picker preview for Quick Actions toolbar (API 31-34). Mirrors expanded tier. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:background="@drawable/widget_background">

    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/widget_preview_play_bg">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_search"
            android:tint="?attr/colorOnPrimary"
            android:contentDescription="@null" />
    </FrameLayout>

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Search with Toolz…"
        android:textSize="15sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:maxLines="1" />

    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/widget_preview_art_bg">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_widget_mic"
            android:tint="?attr/colorOnSurfaceVariant"
            android:contentDescription="@null" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/widget_preview_art_bg">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_flashlight"
            android:tint="?attr/colorOnSurfaceVariant"
            android:contentDescription="@null" />
    </FrameLayout>
</LinearLayout>
