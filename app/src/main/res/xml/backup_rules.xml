<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- PurgeShot durability: full backup includes DB + DataStore so queue survives update/restore -->
    <include domain="database" path="toolz_db" />
    <include domain="database" path="toolz_db-wal" />
    <include domain="database" path="toolz_db-shm" />
    <include domain="sharedpref" path="." />
    <include domain="file" path="datastore/settings.preferences_pb" />
    <!-- External mirror Documents/Toolz/.purgeshot_queue.json survives clear-data independently (not in backup, persisted via MediaStore) -->
</full-backup-content>